{
  "name": "Claude with mandatory proxy and offline Docker",
  "dockerComposeFile": "compose.yaml",
  "service": "agent",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "updateRemoteUserUID": false,
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "initializeCommand": "chmod 600 .secrets/sumi/secrets.txt && .devcontainer/claude/scripts/initialize.sh",
  "postStartCommand": "wait-ready.sh",
  "waitFor": "postStartCommand",
  "userEnvProbe": "none",
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code"],
      "settings": {
        "remote.downloadExtensionsLocally": true
      }
    }
  }
}
