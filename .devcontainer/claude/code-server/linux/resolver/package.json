{
  "name": "agent-resolver",
  "displayName": "claude-devcontainer agent",
  "description": "Connects VS Code to the agent's VS Code server through code-server-proxy.",
  "publisher": "claude-devcontainer",
  "version": "0.1.0",
  "engines": {"vscode": "^1.100.0"},
  "main": "./extension.js",
  "activationEvents": ["onResolveRemoteAuthority:claude-devcontainer"],
  "extensionKind": ["ui"],
  "enabledApiProposals": ["resolvers"],
  "contributes": {
    "resourceLabelFormatters": [{
      "scheme": "vscode-remote",
      "authority": "claude-devcontainer+*",
      "formatting": {"label": "${path}", "separator": "/", "workspaceSuffix": "agent"}
    }]
  }
}
