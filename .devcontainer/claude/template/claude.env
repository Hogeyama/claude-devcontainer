# Settings of this workspace's container, committed with it. See the
# beginning of claude/compose.yaml for all of them. Settings for one host only
# (UID, networks, paths) go in .env next to this file, which overrides these
# and should not be committed.
# CLAUDE_DEVCONTAINER_DIND=1
# CLAUDE_DEVCONTAINER_NIX=1
# CLAUDE_DEVCONTAINER_SUMI=1
# CLAUDE_DEVCONTAINER_PROXY_CA=/etc/ssl/certs/company-root.pem
